---
import DownloadPage from '../layouts/DownloadPage.astro';
import { homeGraph } from '../lib/seo.mjs';
import { readCatalog, readAndroidCatalog } from '../lib/catalog.mjs';
import catalog from '../data/catalog.json';
import android from '../data/android.json';
const canonical = new URL('/', Astro.site);
const title = 'Expo Go Downloads — IPA & APK for SDK 52–58';
const description = 'Download Expo Go for SDK 52–58: community iOS IPAs, original signed Android APKs, and one LiveContainer source. Choose the SDK your project uses.';
const downloads = [...readCatalog(catalog).map(build => ({...build, os: 'iOS', format: 'IPA'})), ...readAndroidCatalog(android).map(build => ({...build, os: 'Android', format: 'APK'}))];
const structuredData = homeGraph(canonical, title, description, downloads);
---
<DownloadPage title={title} description={description} canonical={canonical} structuredData={structuredData}/>
