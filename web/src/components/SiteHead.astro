---
interface Props {
  title: string;
  description: string;
  canonical: URL;
  structuredData: Record<string, unknown>;
}
const { title, description, canonical, structuredData } = Astro.props;
---
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f9fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090a0c" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="XmtK16eIg3_HQ-BmOSYLNAMBpfDkeJZ8EWbEurv73eM" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-light.ico" sizes="16x16 32x32 64x64" data-theme-icon="/favicon-{theme}.ico" />
    <link rel="icon" type="image/png" href="/favicon-light-32.png" sizes="32x32" data-theme-icon="/favicon-{theme}-32.png" />
    <link rel="icon" type="image/png" href="/favicon-light-64.png" sizes="64x64" data-theme-icon="/favicon-{theme}-64.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" data-theme-icon="/favicon-{theme}.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-light.png" sizes="180x180" data-theme-icon="/apple-touch-icon-{theme}.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Expo Go Builds — iOS & Android" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social.png', canonical)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Your SDK. Your phone. Expo Go for iOS and Android." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:alt" content="Your SDK. Your phone. Expo Go for iOS and Android." />
    <meta name="twitter:image" content={new URL('/social.png', canonical)} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <script is:inline>
      (() => {
        let theme = 'system';
        try { const saved = localStorage.getItem('expo-theme'); if (['system', 'light', 'dark'].includes(saved)) theme = saved; } catch {}
        const media = matchMedia('(prefers-color-scheme: dark)');
        const syncIcons = () => {
          const mode = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
          document.querySelectorAll('link[data-theme-icon]').forEach(link => {
            const href = link.dataset.themeIcon.replace('{theme}', mode);
            if (link.getAttribute('href') !== href) link.setAttribute('href', href);
          });
        };
        const apply = () => {
          const mode = document.documentElement.dataset.theme || theme;
          document.documentElement.classList.toggle('dark', mode === 'dark' || (mode === 'system' && media.matches));
          syncIcons();
          window.dispatchEvent(new Event('expo-theme-change'));
        };
        document.documentElement.dataset.theme = theme;
        apply();
        media.addEventListener('change', apply);
        window.addEventListener('expo-theme-change', syncIcons);
        document.addEventListener('click', event => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
          const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('expo-theme', next); } catch {}
          apply();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        let clearHighlight = () => {};
        document.addEventListener('click', event => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-install-guide]')) return;
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const section = document.getElementById('installation-options');
          const heading = document.querySelector('#signing-heading .guide-target');
          if (!section || !heading) return;
          event.preventDefault();
          clearHighlight();
          if (location.hash !== '#installation-options') history.pushState(null, '', '#installation-options');
          let idleTimer;
          let highlightTimer;
          const highlight = () => {
            window.removeEventListener('scroll', onScroll);
            document.getElementById('signing-heading').focus({ preventScroll: true });
            document.documentElement.setAttribute('data-guide-highlight', '');
            highlightTimer = setTimeout(() => document.documentElement.removeAttribute('data-guide-highlight'), 700);
          };
          const onScroll = () => {
            clearTimeout(idleTimer);
            idleTimer = setTimeout(highlight, 80);
          };
          clearHighlight = () => {
            window.removeEventListener('scroll', onScroll);
            clearTimeout(idleTimer);
            clearTimeout(highlightTimer);
            document.documentElement.removeAttribute('data-guide-highlight');
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          section.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
          onScroll();
        });
      })();
    </script>
